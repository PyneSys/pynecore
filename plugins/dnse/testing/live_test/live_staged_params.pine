//@version=6
// LIVE TEST — PARAMETER MATRIX (staged) — card rubycell/pynecore#22, Groups B/C + phase
// probes. Same discipline as live_staged_place_cancel.pine (T1-T13): every order is
// 1 contract unless a test NEEDS more (T24/T25/T30 are flagged), priced >=4.5% from
// market so the venue ACCEPTS and RESTS it but it cannot fill. Nothing should ever fill.
//
//   state 0 -> T19  stop-limit combo: entry(limit= AND stop=) must rest as ONE
//                   conditional stop-limit, NOT an OCO pair (evidence for #14)
//   state 1 -> T20  SHORT sell-stop entry -5% (below market). T7 proved a LONG buy-stop
//                   places on the conditional book; the SELL trigger direction has
//                   never been placed. Evidence for #13's "stop entries" claim.
//   state 2 -> T21  qty omitted -> venue qty must equal default_qty_value (=1)
//   state 3 -> T22  exit(profit=/loss= in TICKS): pre-fill legs must rest at exactly
//                   entry +/- N*mintick (tick->price conversion at the venue boundary)
//   state 4 -> T23  NEGATIVE probe: exit with ONLY trail_* params must place NOTHING
//                   at the venue pre-activation. PASS = entry is the only working order.
//   state 5 -> T24  qty_percent=50 against a resting 2-lot entry -> exit leg rests qty 1
//                   (2-lot state, still >=4.5% away)
//   state 6 -> T25  TWO exit()s against one 2-lot entry: both rest, combined qty <= 2
//                   (2-lot state)
//   state 7 -> T26a close("GHOST") with no position and no order -> clean no-op,
//                   ZERO [BROKER] activity
//   state 8 -> T26b close() while the entry RESTS unfilled -> must NOT cancel the
//                   resting entry (close targets positions); verify, then cancel
//   state 9 -> T30  risk.max_position_size(2) + entry qty=5 -> venue order must rest
//                   at qty 2 (engine trims at placement, _adjust_for_max_position_size)
//   state 10 -> T16a place 1 far limit and HOLD (never advances) — kill the engine here.
//                   Driven by run_t16_restart.sh.
//   state 11 -> T16b post-restart observe: relaunch with startState=11 against the SAME
//                   account; the pre-existing T16 order must be adopted/quarantined
//                   EXPLICITLY (watch [BROKER] startup lines), then cancel_all() must
//                   reach it. PASS = no duplicate placement, venue-clean at end.
//   state 12 -> T14  ATC probe: place ~14:25 (CONT-PM), HOLD until phase==ATC, then
//                   cancel -> venue refuses (CANNOT_CANCEL_THE_ORDER_IN_THE_ATC_SESSION);
//                   plugin must surface + park, NOT crash. The order then EXPIRES at the
//                   close — grade its terminal state from the venue next morning.
//                   CAVEAT: if the feed delivers no bars during ATC this state cannot
//                   fire mid-ATC from Pine; fall back to an L0-style direct probe.
//   state 13 -> T32  ATO probe (first ever): run with startState=13 in the ~08:45-09:00
//                   window. Attempts a far limit AND a conditional stop; records which
//                   the venue refuses (CAN_NOT_PLACE_ORDER_WITH_THAT_ORDER_TYPE_ON_ATO_
//                   SESSION). Whatever rested is cancelled once phase leaves ATO.
//                   Same bar-delivery caveat as T14.
//   state 14 -> done, nothing further is placed
//
// NOT in this file (declaration-level, own files): T27 calc_on_every_tick
// (live_t27_tick_dedup.pine), T31 risk.allow_entry_in (live_t31_direction_gate.pine),
// T28 pyramiding (live_t28_pyramiding.pine, later slice). T33 closed-hours placement
// is impossible from Pine (no bars while closed -> this code never runs); it belongs
// in level0_venue_semantics as a direct-API reject probe.
//
// PHASE STAMPING (card #22 rule): every bar line and every PLACE/CANCEL log carries
// phase=... derived from ICT time-of-day. The same venue reply flips meaning by phase
// (cancel-refused: expected in ATC, a bug in CONT), so a verdict without its phase is
// ungradeable. Taxonomy: CLOSED | ATO 08:45-09:00 (unmeasured until T32) | POST-ATO
// 09:00-09:15 (unmeasured) | CONT-AM 09:15-11:30 | LUNCH | CONT-PM 13:00-14:30 |
// ATC 14:30-14:45 | CLOSED. Weekends are CLOSED.
//
// TRADE WINDOW: same contract as the L1 probe — placement only inside
// [winStart, winEnd]; live winStart MUST be after launch (warmup replays ~500 bars);
// mid-stage steps and cancels are NOT bounded by winEnd.
//
// Reading the results: grep the run log for "[PRM]"; cross-check "[BROKER]" lines;
// grade every verdict from DNSE's own records, phase included.
strategy("LIVE staged param matrix", overlay=true, pyramiding=0, initial_capital=500000000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     margin_long=18.48, margin_short=18.48,
     slippage=1,
     calc_on_every_tick=false, process_orders_on_close=false)

// T30's cap. Global: also caps T24/T25/T26 at their qty=2 (2 <= 2, no effect) and every
// 1-lot state (no effect). Only T30's qty=5 exercises the trim.
strategy.risk.max_position_size(2)

// --- inputs (edit in the generated .toml, not here) ---
winStart = input.time(timestamp("2030-01-01T00:00:00+07:00"), "Trade window START")
winEnd   = input.time(timestamp("2030-01-01T23:59:00+07:00"), "Trade window END")
// Resume: 0=T19 1=T20 2=T21 3=T22 4=T23 5=T24 6=T25 7=T26a 8=T26b 9=T30 10=T16a(hold)
// 11=T16b(post-restart) 12=T14(ATC slot) 13=T32(ATO slot)
startState = input.int(0, "Start at state (0=T19 .. 13=T32)", minval=0, maxval=13)

var int   state     = startState
var int   placedBar = na    // bar_index of this stage's LAST action; na = nothing pending
var int   stageStep = 0     // 0 = just placed; 1 = mid-stage action done
var float lvlEntry  = na    // frozen levels — a moving level would amend every bar
var float lvlStop   = na
var float lvlTP     = na
var bool  announced = false

// ---------------------------------------------------------------- phase stamp
phaseOf() =>
    dow = dayofweek(time, "Asia/Ho_Chi_Minh")
    hm  = hour(time, "Asia/Ho_Chi_Minh") * 100 + minute(time, "Asia/Ho_Chi_Minh")
    dow == dayofweek.saturday or dow == dayofweek.sunday ? "CLOSED" :
         hm < 845  ? "CLOSED"   :
         hm < 900  ? "ATO"      :
         hm < 915  ? "POST-ATO" :
         hm < 1130 ? "CONT-AM"  :
         hm < 1300 ? "LUNCH"    :
         hm < 1430 ? "CONT-PM"  :
         hm < 1445 ? "ATC"      : "CLOSED"

phase    = phaseOf()
isGreen  = close > open
pending  = not na(placedBar)
started  = time >= winStart
canPlace = started and time <= winEnd
// Continuous-only gate for states 0-11: placements AND cancels. Measured in the
// 2026-08-15 dry run: without this, T24 placed 14:28 and cancelled 14:29 — one bar
// later and the cancel lands in ATC, where the venue REFUSES it and the order strands.
// Only T14 (state 12) and T32 (state 13) deliberately operate outside continuous.
contOK   = phase == "CONT-AM" or phase == "CONT-PM"

if started

    if not announced
        log.info("[PRM] === PARAM MATRIX — window open. T19-T26/T30 continuous, T16 hold/restart, " +
                 "T14 ATC, T32 ATO. 1 contract unless flagged, >=4.5% away. startState={0} ===",
                 startState)
        announced := true

    log.info("[PRM] bar={0} close={1} candle={2} phase={3} state={4} step={5} pending={6} pos={7}",
             bar_index, str.tostring(close, format.mintick), isGreen ? "GREEN" : "RED",
             phase, state, stageStep, pending ? "yes" : "no", strategy.position_size)

    // ------------------------------------------------------------ placement
    if canPlace and not pending and state < 14 and (state >= 12 or contOK)
        if state == 0 and isGreen
            // BOTH legs must be unmarketable under EVERY interpretation of limit+stop:
            // trigger +5% (above market: a stop RESTS), limit -5% (below market: a buy
            // limit RESTS). Measured in the 2026-08-15 dry run: a limit ABOVE market is
            // instantly marketable — the sim FILLED it at market. The venue book still
            // answers #14: ONE stop-limit (trigger 1.05c/limit 0.95c) vs TWO orders.
            lvlStop  := close * 1.05
            lvlTP    := close * 0.95    // limit leg BELOW market — rests, never fills
            strategy.entry("T19", strategy.long, stop=lvlStop, limit=lvlTP, comment="T19")
            placedBar := bar_index
            log.info("[PRM] T19 PLACE phase={0} buy STOP-LIMIT trigger={1} limit={2} — KEY (#14): " +
                     "venue must show exactly ONE conditional stop-limit, NOT an OCO pair",
                     phase, str.tostring(lvlStop, format.mintick), str.tostring(lvlTP, format.mintick))

        else if state == 1
            lvlStop := close * 0.95
            strategy.entry("T20", strategy.short, stop=lvlStop, comment="T20")
            placedBar := bar_index
            log.info("[PRM] T20 PLACE phase={0} SHORT sell-STOP {1} (-5%) — first-ever SELL " +
                     "trigger direction on the conditional book (#13 evidence): reject loudly, " +
                     "emulate, or silent drop? Watch [BROKER]",
                     phase, str.tostring(lvlStop, format.mintick))

        else if state == 2 and isGreen
            lvlEntry := close * 0.95
            strategy.entry("T21", strategy.long, limit=lvlEntry, comment="T21")  // qty OMITTED
            placedBar := bar_index
            log.info("[PRM] T21 PLACE phase={0} qty OMITTED limit={1} — venue qty must equal " +
                     "default_qty_value=1 (sizing path)", phase, str.tostring(lvlEntry, format.mintick))

        else if state == 3 and isGreen
            lvlEntry := close * 0.95
            profitTicks = math.round(close * 0.10 / syminfo.mintick)  // +10% of px above ENTRY
            lossTicks   = math.round(close * 0.01 / syminfo.mintick)  // 1% of px below ENTRY
            lvlTP   := lvlEntry + profitTicks * syminfo.mintick       // ~ +5% above MARKET: rests
            lvlStop := lvlEntry - lossTicks * syminfo.mintick         // ~ -6% below market
            strategy.entry("T22", strategy.long, limit=lvlEntry, comment="T22")
            strategy.exit("X22", from_entry="T22", profit=profitTicks, loss=lossTicks,
                          comment_profit="X22tp", comment_loss="X22sl")
            placedBar := bar_index
            log.info("[PRM] T22 PLACE phase={0} entry={1} + exit(profit={2}t loss={3}t) — KEY: " +
                     "venue legs must rest at EXACTLY tp={4} sl={5} (entry +/- N*mintick)",
                     phase, str.tostring(lvlEntry, format.mintick), profitTicks, lossTicks,
                     str.tostring(lvlTP, format.mintick), str.tostring(lvlStop, format.mintick))

        else if state == 4 and isGreen
            lvlEntry := close * 0.95
            trailPts = math.round(close * 0.02 / syminfo.mintick)
            strategy.entry("T23", strategy.long, limit=lvlEntry, comment="T23")
            strategy.exit("X23", from_entry="T23", trail_points=trailPts, trail_offset=trailPts,
                          comment_trailing="X23tr")
            placedBar := bar_index
            log.info("[PRM] T23 PLACE phase={0} entry={1} + exit(trail_points={2} ONLY) — " +
                     "NEGATIVE PROBE: trailing is engine-emulated; NOTHING of X23 may reach the " +
                     "venue pre-activation. PASS = T23 is the ONLY working order",
                     phase, str.tostring(lvlEntry, format.mintick), trailPts)

        else if state == 5 and isGreen
            lvlEntry := close * 0.95
            lvlStop  := close * 0.94
            strategy.entry("T24", strategy.long, qty=2, limit=lvlEntry, comment="T24")  // 2-lot state
            strategy.exit("X24", from_entry="T24", qty_percent=50, stop=lvlStop, comment_loss="X24")
            placedBar := bar_index
            log.info("[PRM] T24 PLACE phase={0} entry qty=2 limit={1} + exit(qty_percent=50 " +
                     "stop={2}) — KEY: the exit leg must rest at venue qty 1 (50% of 2)",
                     phase, str.tostring(lvlEntry, format.mintick), str.tostring(lvlStop, format.mintick))

        else if state == 6 and isGreen
            lvlEntry := close * 0.95
            lvlStop  := close * 0.94
            lvlTP    := close * 0.935
            strategy.entry("T25", strategy.long, qty=2, limit=lvlEntry, comment="T25")  // 2-lot state
            strategy.exit("X25a", from_entry="T25", qty=1, stop=lvlStop, comment_loss="X25a")
            strategy.exit("X25b", from_entry="T25", qty=1, stop=lvlTP,  comment_loss="X25b")
            placedBar := bar_index
            log.info("[PRM] T25 PLACE phase={0} entry qty=2 + TWO exits qty=1 each (stops {1} / " +
                     "{2}) — both must rest, combined qty <= entry qty; then cancel all three",
                     phase, str.tostring(lvlStop, format.mintick), str.tostring(lvlTP, format.mintick))

        else if state == 7
            strategy.close("GHOST", comment="T26a")
            placedBar := bar_index   // no order exists; next bar just advances
            log.info("[PRM] T26a close('GHOST') phase={0} with NO position and NO order — " +
                     "PASS = clean no-op, ZERO [BROKER] activity on this bar", phase)

        else if state == 8 and isGreen
            lvlEntry := close * 0.95
            strategy.entry("T26", strategy.long, limit=lvlEntry, comment="T26")
            placedBar := bar_index
            log.info("[PRM] T26b PLACE phase={0} limit={1} — NEXT bar calls strategy.close('T26') " +
                     "while it RESTS: close() targets POSITIONS and must NOT cancel the resting " +
                     "entry", phase, str.tostring(lvlEntry, format.mintick))

        else if state == 9 and isGreen
            lvlEntry := close * 0.95
            strategy.entry("T30", strategy.long, qty=5, limit=lvlEntry, comment="T30")
            placedBar := bar_index
            log.info("[PRM] T30 PLACE phase={0} qty=5 limit={1} with risk.max_position_size(2) — " +
                     "KEY: engine trims at placement; venue order must rest at qty 2, not 5",
                     phase, str.tostring(lvlEntry, format.mintick))

        else if state == 10 and isGreen
            lvlEntry := close * 0.95
            strategy.entry("T16", strategy.long, limit=lvlEntry, comment="T16")
            placedBar := bar_index
            log.info("[PRM] T16a PLACE-AND-HOLD phase={0} limit={1} — this state NEVER advances. " +
                     "Kill the engine now (run_t16_restart.sh drives this), then relaunch with " +
                     "startState=11", phase, str.tostring(lvlEntry, format.mintick))

        else if state == 12 and (phase == "CONT-PM" or phase == "ATC")
            lvlEntry := close * 0.95
            lvlStop  := close * 0.94   // rider: placed same bar, LEFT to expire at the close
            strategy.entry("T14", strategy.long, limit=lvlEntry, comment="T14")
            strategy.entry("T14r", strategy.long, limit=lvlStop, comment="T14r")
            placedBar := bar_index
            log.info("[PRM] T14 PLACE phase={0} T14 limit={1} + rider T14r limit={2} — cancel of " +
                     "T14 fires only when phase==ATC (venue must REFUSE: CANNOT_CANCEL_..._ATC); " +
                     "T14r is never cancelled and must EXPIRE at the close. Grade both terminal " +
                     "states from the venue AFTER the session",
                     phase, str.tostring(lvlEntry, format.mintick), str.tostring(lvlStop, format.mintick))

        else if state == 13 and (phase == "ATO" or phase == "POST-ATO")
            lvlEntry := close * 0.95
            lvlStop  := close * 1.05
            strategy.entry("T32a", strategy.long, limit=lvlEntry, comment="T32a")
            strategy.entry("T32b", strategy.long, stop=lvlStop, comment="T32b")
            placedBar := bar_index
            log.info("[PRM] T32 PLACE phase={0} (FIRST-EVER ATO measurement) T32a limit={1} + " +
                     "T32b cond stop={2} — record per-type accept/refuse " +
                     "(CAN_NOT_PLACE_..._ON_ATO_SESSION); survivors cancelled once phase " +
                     "leaves ATO", phase, str.tostring(lvlEntry, format.mintick),
                     str.tostring(lvlStop, format.mintick))

    // ------------------------------------------------------------ mid-stage + cancel + advance
    // Deliberately NOT gated by winEnd: a placed order must always reach its cancel.
    // But it IS phase-gated for the continuous-only states: a cancel issued in ATC is
    // refused by the venue and the order strands (that scenario is T14's, by design).
    if pending and bar_index > placedBar and (state >= 12 or contOK)
        if state == 8 and stageStep == 0
            // T26b mid-stage: the close() that must NOT touch the resting entry
            strategy.close("T26", comment="T26close")
            stageStep := 1
            placedBar := bar_index
            log.info("[PRM] T26b CLOSE ATTEMPT phase={0} — strategy.close('T26') with zero " +
                     "position: expect NO venue cancel; T26 must STILL be resting after this bar",
                     phase)
        else if state == 10
            // T16a: hold forever — announce once per bar so the runner can see liveness
            log.info("[PRM] T16a HOLDING phase={0} — order resting, awaiting kill", phase)
        else if state == 12 and stageStep == 0
            if phase == "ATC"
                strategy.cancel("T14")
                stageStep := 1
                placedBar := bar_index
                log.info("[PRM] T14 CANCEL-IN-ATC phase={0} — venue must REFUSE " +
                         "(CANNOT_CANCEL_THE_ORDER_IN_THE_ATC_SESSION); plugin must surface + " +
                         "park, NOT crash. T14/T14r then EXPIRE at the close", phase)
            else
                log.info("[PRM] T14 WAITING for ATC phase={0} — order resting through CONT-PM", phase)
        else if state == 12 and stageStep == 1
            // attempted; nothing more to do live — both orders expire at the close
            log.info("[PRM] T14 DONE (attempt made) phase={0} — grade terminal states from the " +
                     "venue after 14:45", phase)
            placedBar := na
            stageStep := 0
            state     := 14
        else if state == 13 and stageStep == 0
            if phase != "ATO" and phase != "POST-ATO"
                strategy.cancel_all()
                stageStep := 1
                placedBar := bar_index
                log.info("[PRM] T32 CANCEL_ALL phase={0} — sweeping whatever the ATO accepted", phase)
            else
                log.info("[PRM] T32 WAITING for continuous phase={0}", phase)
        else
            if state == 0
                strategy.cancel("T19")
                log.info("[PRM] T19 CANCEL")
            else if state == 1
                strategy.cancel("T20")
                log.info("[PRM] T20 CANCEL")
            else if state == 2
                strategy.cancel("T21")
                log.info("[PRM] T21 CANCEL")
            else if state == 3
                strategy.cancel("T22")
                strategy.cancel("X22")
                log.info("[PRM] T22 CANCEL id=T22 and id=X22 (both, explicitly)")
            else if state == 4
                strategy.cancel("T23")
                log.info("[PRM] T23 CANCEL id=T23 — X23 must never have existed at the venue")
            else if state == 5
                strategy.cancel("T24")
                strategy.cancel("X24")
                log.info("[PRM] T24 CANCEL id=T24 and id=X24")
            else if state == 6
                strategy.cancel("T25")
                strategy.cancel("X25a")
                strategy.cancel("X25b")
                log.info("[PRM] T25 CANCEL all three, explicitly")
            else if state == 7
                log.info("[PRM] T26a DONE — verify the [BROKER] silence on the previous bar")
            else if state == 8
                strategy.cancel("T26")
                log.info("[PRM] T26b CANCEL id=T26 (explicit, after the close() no-op)")
            else if state == 9
                strategy.cancel("T30")
                log.info("[PRM] T30 CANCEL")
            else if state == 11
                strategy.cancel_all()
                log.info("[PRM] T16b POST-RESTART cancel_all — the adopted/quarantined T16 " +
                         "must be reachable; venue must be clean after")
            else if state == 13
                log.info("[PRM] T32 DONE")
            log.info("[PRM] STAGE DONE phase={0} — state {1}->{2}", phase, state, state + 1)
            placedBar := na
            stageStep := 0
            state     := state + 1
            if state == 14
                log.info("[PRM] === PARAM MATRIX DONE. Verify at the venue that NOTHING of ours " +
                         "is still working, then stop the run. ===")

    // T16b entry: nothing pending on arrival (fresh relaunch) — give reconciliation two
    // bars of log before sweeping. contOK: the sweep must not land in lunch/ATC.
    if state == 11 and not pending and started and contOK
        if stageStep < 2
            stageStep := stageStep + 1
            log.info("[PRM] T16b OBSERVE bar {0}/2 phase={1} — watch [BROKER] startup: the " +
                     "resting T16 must be adopted or quarantined EXPLICITLY, never silent",
                     stageStep, phase)
        else
            placedBar := bar_index - 1   // arm the cancel path above on this same bar
            stageStep := 0

    // ------------------------------------------------------------ safety
    if strategy.position_size != 0
        log.error("[PRM] !!! UNEXPECTED FILL phase={0}: pos={1} avg={2} — cancelling all and " +
                  "flattening", phase, strategy.position_size,
                  str.tostring(strategy.position_avg_price, format.mintick))
        strategy.cancel_all()
        strategy.close_all(comment="SAFETY-FLATTEN")

plot(state, "state", display=display.data_window)
plot(strategy.position_size, "pos", display=display.data_window)
plot(lvlEntry, "entry_lvl", display=display.data_window)
plot(lvlStop, "stop_lvl", display=display.data_window)
