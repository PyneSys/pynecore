//@version=6
// LIVE TEST T31 — strategy.risk.allow_entry_in(long_only) direction gate.
// Card rubycell/pynecore#22 Group C (strategy.risk.* namespace, never live-tested).
//
// Declaration-level: the risk rule is global, so this cannot share a file with tests
// that place shorts (it would block them). Two stages:
//   state 0 -> a SHORT far limit entry: the engine must emit NOTHING — zero [BROKER]
//              activity, nothing at the venue. PASS = silence.
//   state 1 -> a LONG far limit entry (control): must place normally, then cancel —
//              proving the gate blocks by DIRECTION, not blocking everything.
//
// All orders 1 contract, >=4.5% away, no fill possible. Phase-stamped; continuous only.
strategy("LIVE T31 direction gate", overlay=true, pyramiding=0, initial_capital=500000000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     margin_long=18.48, margin_short=18.48,
     slippage=1,
     calc_on_every_tick=false, process_orders_on_close=false)

strategy.risk.allow_entry_in(strategy.direction.long)

winStart = input.time(timestamp("2030-01-01T00:00:00+07:00"), "Trade window START")
winEnd   = input.time(timestamp("2030-01-01T23:59:00+07:00"), "Trade window END")
startState = input.int(0, "Start at state (0=short-blocked 1=long-control)", minval=0, maxval=1)

var int   state     = startState
var int   placedBar = na
var float lvlEntry  = na
var bool  announced = false

phaseOf() =>
    dow = dayofweek(time, "Asia/Ho_Chi_Minh")
    hm  = hour(time, "Asia/Ho_Chi_Minh") * 100 + minute(time, "Asia/Ho_Chi_Minh")
    dow == dayofweek.saturday or dow == dayofweek.sunday ? "CLOSED" :
         hm < 845  ? "CLOSED"   :
         hm < 900  ? "ATO"      :
         hm < 915  ? "POST-ATO" :
         hm < 1130 ? "CONT-AM"  :
         hm < 1300 ? "LUNCH"    :
         hm < 1430 ? "CONT-PM"  :
         hm < 1445 ? "ATC"      : "CLOSED"

phase   = phaseOf()
pending = not na(placedBar)

if time >= winStart
    if not announced
        log.info("[T31] === DIRECTION GATE — allow_entry_in(long). startState={0} ===", startState)
        announced := true

    log.info("[T31] bar={0} phase={1} state={2} pending={3}", bar_index, phase, state,
             pending ? "yes" : "no")

    if time <= winEnd and not pending and state < 2
        if state == 0
            lvlEntry := close * 1.05
            strategy.entry("T31s", strategy.short, limit=lvlEntry, comment="T31s")
            placedBar := bar_index
            log.info("[T31] state0 SHORT attempt phase={0} limit={1} — the gate must swallow " +
                     "this: ZERO [BROKER] lines, NOTHING at the venue. Any placement is a FAIL",
                     phase, str.tostring(lvlEntry, format.mintick))
        else if state == 1 and close > open
            lvlEntry := close * 0.95
            strategy.entry("T31l", strategy.long, limit=lvlEntry, comment="T31l")
            placedBar := bar_index
            log.info("[T31] state1 LONG control phase={0} limit={1} — must place normally " +
                     "(proves the gate is directional, not total)", phase,
                     str.tostring(lvlEntry, format.mintick))

    if pending and bar_index > placedBar
        if state == 0
            log.info("[T31] state0 VERIFY phase={0} — confirm venue shows nothing of T31s", phase)
        else if state == 1
            strategy.cancel("T31l")
            log.info("[T31] state1 CANCEL T31l. DONE — verify venue clean", phase)
        placedBar := na
        state     := state + 1
        if state == 2
            log.info("[T31] === DONE ===")

if strategy.position_size != 0
    log.error("[T31] !!! UNEXPECTED FILL phase={0} pos={1} — flatten", phase, strategy.position_size)
    strategy.cancel_all()
    strategy.close_all(comment="SAFETY-FLATTEN")

plot(state, "state", display=display.data_window)
