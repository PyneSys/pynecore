recursive-include src/pynecore *.json
include NOTICE
include LICENSE
include src/pynecore/core/_native_math.pyx
include src/pynecore/core/_native_rolling_sum.pyx
include src/pynecore/core/_native_color.pyx
# The Rust sources of the native transform (pynecore.transformers._native)
recursive-include rust *.rs *.toml *.json *.lock *.py *.sh *.mjs *.md
prune rust/target
