# DNSE OpenAPI credentials — TEMPLATE
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored; this file is not. NEVER put real credentials here.

# --- Credentials (HMAC-SHA256 signing for REST + WebSocket) ---
DNSE_API_KEY=your-api-key-here
DNSE_API_SECRET=your-api-secret-here

# --- Endpoints ---
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn

# Sent in the `version` header. SDK default is 2026-01-01.
DNSE_API_VERSION=2026-01-01

# json | msgpack
DNSE_WS_ENCODING=json

# --- Order path (NOT needed for market-data probes) ---
# The trading token is derived at runtime, not stored:
#   POST /registration/send-email-otp  ->  read OTP  ->  POST /registration/trading-token
# It is short-lived; TTL is an open question on the broker card.
DNSE_OTP_TYPE=email_otp

#
# NOT here on purpose — these vary per run and per asset:
#
#   symbol + timeframe  -> the provider string, e.g.
#                            pyne run <script> dnse:VN30F1M@15
#                            pyne data download dnse:HPG@1D
#
#   marketType          -> derived per symbol by the plugin (DNSE trades
#                          stocks, derivatives and more; it is a property of
#                          the instrument, not of the environment). Resolve
#                          via GET /instruments or /price/{symbol}/secdef.
#
#   accountNo           -> an account is per market type, and a user may hold
#                          several. Enumerate with GET /accounts
#                          (client.get_accounts) and select per run; do not
#                          pin one globally here.
#
#   symbol_map, loan packages, per-account defaults
#                       -> the plugin's typed Config, surfaced as
#                          workdir/config/plugins/dnse.toml (self-healing,
#                          same pattern as ccxt.toml)

# NOTE: there is deliberately no DNSE_DRY_RUN switch. An earlier draft
# advertised one, but nothing read it — setting it would have sent real orders
# while looking safe. To exercise the order path without touching the venue,
# point base_url/ws_url at the local fake (plugins/dnse/testing/fake_dnse.py).
